      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --apple-blue: #0066CC;\n    --near-white: #FBFBFD;\n    --pure-white: #FFFFFF;\n    --pitch-black: #000000;\n    --text-primary: #1D1D1F;\n    --text-secondary: #86868B;\n    --luminous-text: #F5F5F7;\n  }\n\n  body {\n    margin: 0;\n    font-family: 'Inter', sans-serif;\n    background-color: var(--near-white);\n    color: var(--text-primary);\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .tracking-tight-apple {\n    letter-spacing: -0.02em;\n  }\n\n  .glass-nav {\n    background: rgba(0, 0, 0, 0.8);\n    backdrop-filter: blur(20px);\n    -webkit-backdrop-filter: blur(20px);\n  }\n\n  .pill-button {\n    border-radius: 9999px;\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  .pill-button:hover {\n    transform: scale(1.02);\n  }\n\n  .input-minimal {\n    border: none;\n    border-bottom: 1px solid #D2D2D7;\n    background: transparent;\n    border-radius: 0;\n    padding: 1rem 0;\n    width: 100%;\n    transition: border-color 0.3s ease;\n  }\n\n  .input-minimal:focus {\n    outline: none;\n    border-bottom-color: var(--apple-blue);\n  }\n\n  .portfolio-card {\n    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  /* Custom scrollbar for horizontal testimonials if needed */\n  .hide-scrollbar::-webkit-scrollbar {\n    display: none;\n  }\n  .hide-scrollbar {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n</style>\n\n\n<nav class=\"fixed top-0 left-0 right-0 h-[44px] glass-nav z-[100] flex items-center justify-between px-6 lg:px-12\" data-kid=\"1\">\n  <div class=\"flex items-center text-[#F5F5F7] text-xl\" data-kid=\"2\">\n    <i class=\"ti ti-command\" data-kid=\"3\"></i>\n    <span class=\"ml-2 text-sm font-semibold tracking-tight uppercase\" data-kid=\"4\">Algoritmo</span>\n  </div>\n  <div class=\"hidden md:flex gap-8 items-center\" data-kid=\"5\">\n    <a href=\"#portfolio\" class=\"text-[12px] text-[#F5F5F7]/80 hover:text-white transition-colors\" data-kid=\"6\">Portfolio</a>\n    <a href=\"#process\" class=\"text-[12px] text-[#F5F5F7]/80 hover:text-white transition-colors\" data-kid=\"7\">Process</a>\n    <a href=\"#testimonials\" class=\"text-[12px] text-[#F5F5F7]/80 hover:text-white transition-colors\" data-kid=\"8\">Testimonials</a>\n    <a href=\"#contact\" class=\"text-[12px] text-[#F5F5F7]/80 hover:text-white transition-colors\" data-kid=\"9\">Contact</a>\n  </div>\n  <div class=\"flex items-center\" data-kid=\"10\">\n    <button class=\"bg-white/10 hover:bg-white/20 text-white text-[11px] px-3 py-1 rounded-full transition-colors\" data-kid=\"11\">Client Login</button>\n  </div>\n</nav>\n\n\n<section class=\"relative min-h-[950px] flex flex-col items-center pt-48 px-6 overflow-hidden bg-[var(--near-white)]\" data-kid=\"12\">\n  <div class=\"text-center max-w-5xl z-10\" data-kid=\"13\">\n    <p class=\"text-[var(--text-secondary)] text-[14px] font-semibold tracking-[0.15em] uppercase mb-8\" data-kid=\"14\">Algoritmo Tiendas</p>\n    <h1 class=\"text-6xl md:text-[84px] leading-[1.02] font-bold text-[var(--text-primary)] tracking-tight-apple mb-10\" data-kid=\"15\">\n      Your local business. <br data-kid=\"16\"><span class=\"text-[var(--apple-blue)]\" data-kid=\"17\">Supercharged.</span>\n    </h1>\n    <p class=\"text-xl md:text-[26px] text-[var(--text-secondary)] max-w-2xl mx-auto mb-12 leading-relaxed font-normal\" data-kid=\"18\">\n      Beautiful, high-converting websites designed to bring customers to your door.\n    </p>\n    <div class=\"flex flex-col sm:flex-row gap-5 justify-center items-center\" data-kid=\"19\">\n      <button class=\"pill-button bg-[var(--apple-blue)] text-white px-12 py-5 text-xl font-medium hover:bg-[#005bb8] cursor-pointer\" data-kid=\"20\">\n        Get Started\n      </button>\n      <button class=\"pill-button border border-[var(--apple-blue)] text-[var(--apple-blue)] px-12 py-5 text-xl font-medium hover:bg-[var(--apple-blue)]/5 cursor-pointer\" data-kid=\"21\">\n        View Portfolio\n      </button>\n    </div>\n  </div>\n  \n  \n  <div class=\"mt-24 w-full max-w-7xl pointer-events-none\" data-kid=\"22\">\n    <img src=\"https://images.unsplash.com/photo-1692607146112-a25194375acb?auto=format&w=1800&q=80&fit=crop\" alt=\"Geometric Abstract Sculpture\" class=\"w-full h-auto object-cover opacity-95 translate-y-12\" decoding=\"async\" loading=\"lazy\" data-kid=\"23\">\n  </div>\n</section>\n\n\n<section id=\"portfolio\" class=\"bg-[var(--pitch-black)] py-48 px-6 lg:px-12\" data-kid=\"24\">\n  <div class=\"max-w-6xl mx-auto text-center mb-40\" data-kid=\"25\">\n    <h2 class=\"text-5xl md:text-[84px] font-bold text-[var(--luminous-text)] tracking-tight-apple leading-none\" data-kid=\"26\">Built for your craft.</h2>\n    <p class=\"text-[var(--text-secondary)] text-2xl mt-8\" data-kid=\"27\">Bespoke digital experiences for industry leaders.</p>\n  </div>\n\n  <div class=\"max-w-7xl mx-auto space-y-48\" data-kid=\"28\">\n    \n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\" data-kid=\"29\">\n      <div class=\"lg:col-span-5 order-2 lg:order-1\" data-kid=\"30\">\n        <h3 class=\"text-4xl md:text-5xl font-bold text-[var(--luminous-text)] mb-8 tracking-tight leading-tight\" data-kid=\"31\">\n          The Culinary Experience. <br data-kid=\"32\"><span class=\"text-[var(--text-secondary)]\" data-kid=\"33\">Taste the design.</span>\n        </h3>\n        <button class=\"pill-button border border-[var(--luminous-text)]/20 text-[var(--luminous-text)] px-8 py-3 text-sm font-medium hover:bg-white/10\" data-kid=\"34\">\n          See the menu\n        </button>\n      </div>\n      <div class=\"lg:col-span-7 order-1 lg:order-2\" data-kid=\"35\">\n        <div class=\"rounded-[22px] overflow-hidden shadow-2xl\" data-kid=\"36\">\n          <img src=\"https://images.unsplash.com/photo-1748551204300-f227d5af350f?auto=format&w=1200&q=80&fit=crop\" alt=\"Moody Restaurant Interior\" class=\"w-full aspect-[4/3] object-cover portfolio-card hover:scale-105\" decoding=\"async\" loading=\"lazy\" data-kid=\"37\">\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"relative w-full h-[600px] rounded-[22px] overflow-hidden\" data-kid=\"38\">\n      <video src=\"https://videos.pexels.com/video-files/4178112/4178112-hd_1280_720_30fps.mp4\" poster=\"https://images.pexels.com/videos/4178112/pexels-photo-4178112.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"absolute inset-0 w-full h-full object-cover\" data-kid=\"39\">\n      </video>\n      <div class=\"absolute inset-0 bg-black/50 flex flex-col items-center justify-center text-center px-6\" data-kid=\"40\">\n        <h3 class=\"text-5xl md:text-[70px] font-bold text-white tracking-tight-apple leading-none mb-6\" data-kid=\"41\">\n          Precision cuts. <br data-kid=\"42\">Precision pixels.\n        </h3>\n        <p class=\"text-white/80 text-xl max-w-xl\" data-kid=\"43\">Every strand, every pixel, perfectly in place.</p>\n      </div>\n    </div>\n\n    \n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\" data-kid=\"44\">\n      <div class=\"lg:col-span-7\" data-kid=\"45\">\n        <div class=\"rounded-[22px] overflow-hidden shadow-2xl\" data-kid=\"46\">\n          <img src=\"https://images.unsplash.com/photo-1629909615184-74f495363b67?auto=format&w=1200&q=80&fit=crop\" alt=\"Modern Clean Clinic\" class=\"w-full aspect-[4/3] object-cover portfolio-card hover:scale-105\" decoding=\"async\" loading=\"lazy\" data-kid=\"47\">\n        </div>\n      </div>\n      <div class=\"lg:col-span-5 text-right\" data-kid=\"48\">\n        <h3 class=\"text-4xl md:text-5xl font-bold text-[var(--luminous-text)] mb-8 tracking-tight leading-tight\" data-kid=\"49\">\n          Trust and Care.\n        </h3>\n        <p class=\"text-[var(--text-secondary)] text-xl mb-10 leading-relaxed\" data-kid=\"50\">\n          Clean interfaces for healing hands. We design clinics that breathe confidence.\n        </p>\n        <button class=\"pill-button border border-[var(--luminous-text)]/20 text-[var(--luminous-text)] px-8 py-3 text-sm font-medium hover:bg-white/10\" data-kid=\"51\">\n          View Project\n        </button>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"process\" class=\"bg-[var(--near-white)] py-32 px-6 lg:px-12\" data-kid=\"52\">\n  <div class=\"max-w-6xl mx-auto\" data-kid=\"53\">\n    <h2 class=\"text-4xl md:text-[48px] font-bold text-[var(--text-primary)] text-center mb-24 tracking-tight\" data-kid=\"54\">How it works.</h2>\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-20\" data-kid=\"55\">\n      <div class=\"text-center group\" data-kid=\"56\">\n        <div class=\"text-[var(--apple-blue)] text-5xl mb-8 flex justify-center transform group-hover:scale-110 transition-transform\" data-kid=\"57\">\n          <i class=\"ti ti-message-circle stroke-[1.5]\" data-kid=\"58\"></i>\n        </div>\n        <h3 class=\"text-2xl font-semibold text-[var(--text-primary)] mb-4\" data-kid=\"59\">Consultation</h3>\n        <p class=\"text-[var(--text-secondary)] text-lg leading-relaxed\" data-kid=\"60\">We learn your business inside and out to craft the perfect strategy for your specific local market.</p>\n      </div>\n      <div class=\"text-center group\" data-kid=\"61\">\n        <div class=\"text-[var(--apple-blue)] text-5xl mb-8 flex justify-center transform group-hover:scale-110 transition-transform\" data-kid=\"62\">\n          <i class=\"ti ti-pen-tool stroke-[1.5]\" data-kid=\"63\"></i>\n        </div>\n        <h3 class=\"text-2xl font-semibold text-[var(--text-primary)] mb-4\" data-kid=\"64\">Design & Build</h3>\n        <p class=\"text-[var(--text-secondary)] text-lg leading-relaxed\" data-kid=\"65\">Premium pixels met with functional, minimalist design to ensure high conversion and a seamless user journey.</p>\n      </div>\n      <div class=\"text-center group\" data-kid=\"66\">\n        <div class=\"text-[var(--apple-blue)] text-5xl mb-8 flex justify-center transform group-hover:scale-110 transition-transform\" data-kid=\"67\">\n          <i class=\"ti ti-rocket stroke-[1.5]\" data-kid=\"68\"></i>\n        </div>\n        <h3 class=\"text-2xl font-semibold text-[var(--text-primary)] mb-4\" data-kid=\"69\">Launch & Grow</h3>\n        <p class=\"text-[var(--text-secondary)] text-lg leading-relaxed\" data-kid=\"70\">Continuous support as your business scales. We're your long-term digital partners, not just developers.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"testimonials\" class=\"bg-[var(--pure-white)] py-40 px-6 lg:px-12\" data-kid=\"71\">\n  <div class=\"max-w-6xl mx-auto\" data-kid=\"72\">\n    <div class=\"text-center mb-24\" data-kid=\"73\">\n      <h2 class=\"text-4xl md:text-[56px] font-bold text-[var(--text-primary)] tracking-tight\" data-kid=\"74\">Voices of Success.</h2>\n    </div>\n    \n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-10\" data-kid=\"75\">\n      \n      <div class=\"bg-[#F5F5F7] p-12 rounded-[32px] flex flex-col justify-between hover:scale-[1.01] transition-all duration-500 cursor-default\" data-kid=\"76\">\n        <p class=\"text-[24px] text-[var(--text-primary)] leading-tight mb-12 font-medium tracking-tight\" data-kid=\"77\">\n          \"The transformation of our digital presence was immediate. Customers now tell us they chose us specifically because of how professional our website looks.\"\n        </p>\n        <div class=\"flex items-center gap-5\" data-kid=\"78\">\n          <img src=\"https://i.pravatar.cc/100?u=marco\" alt=\"Marco\" class=\"w-14 h-14 rounded-full grayscale\" decoding=\"async\" loading=\"lazy\" data-kid=\"79\">\n          <div data-kid=\"80\">\n            <p class=\"text-[17px] font-bold text-[var(--text-primary)]\" data-kid=\"81\">Marco Rossi</p>\n            <p class=\"text-[13px] font-semibold text-[var(--text-secondary)] uppercase tracking-widest\" data-kid=\"82\">Trattoria Bella</p>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"bg-[#F5F5F7] p-12 rounded-[32px] flex flex-col justify-between hover:scale-[1.01] transition-all duration-500 cursor-default\" data-kid=\"83\">\n        <p class=\"text-[24px] text-[var(--text-primary)] leading-tight mb-12 font-medium tracking-tight\" data-kid=\"84\">\n          \"Algoritmo Tiendas understood exactly what our clinic needed. They didn't just build a site; they built a trust engine for our patients.\"\n        </p>\n        <div class=\"flex items-center gap-5\" data-kid=\"85\">\n          <img src=\"https://i.pravatar.cc/100?u=sarah\" alt=\"Sarah\" class=\"w-14 h-14 rounded-full grayscale\" decoding=\"async\" loading=\"lazy\" data-kid=\"86\">\n          <div data-kid=\"87\">\n            <p class=\"text-[17px] font-bold text-[var(--text-primary)]\" data-kid=\"88\">Dr. Sarah Jenkins</p>\n            <p class=\"text-[13px] font-semibold text-[var(--text-secondary)] uppercase tracking-widest\" data-kid=\"89\">Jenkins Dental</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"contact\" class=\"bg-[var(--near-white)] py-40 px-6 lg:px-12\" data-kid=\"90\">\n  <div class=\"max-w-xl mx-auto text-center\" data-kid=\"91\">\n    <h2 class=\"text-5xl md:text-[72px] font-bold text-[var(--text-primary)] mb-20 tracking-tight\" data-kid=\"92\">Let's talk.</h2>\n    <form class=\"space-y-12 text-left\" data-kid=\"93\">\n      <div class=\"group\" data-kid=\"94\">\n        <label class=\"text-[11px] font-bold text-[var(--text-secondary)] uppercase tracking-[0.2em] mb-2 block\" data-kid=\"95\">Full Name</label>\n        <input type=\"text\" placeholder=\"Your name\" class=\"input-minimal text-xl py-3\" data-kid=\"96\">\n      </div>\n      <div class=\"group\" data-kid=\"97\">\n        <label class=\"text-[11px] font-bold text-[var(--text-secondary)] uppercase tracking-[0.2em] mb-2 block\" data-kid=\"98\">Email Address</label>\n        <input type=\"email\" placeholder=\"email@address.com\" class=\"input-minimal text-xl py-3\" data-kid=\"99\">\n      </div>\n      <div class=\"group\" data-kid=\"100\">\n        <label class=\"text-[11px] font-bold text-[var(--text-secondary)] uppercase tracking-[0.2em] mb-2 block\" data-kid=\"101\">Project Vision</label>\n        <textarea placeholder=\"Tell us about your goals...\" rows=\"2\" class=\"input-minimal text-xl py-3 resize-none\" data-kid=\"102\"></textarea>\n      </div>\n      <div class=\"text-center pt-8\" data-kid=\"103\">\n        <button class=\"pill-button bg-[var(--apple-blue)] text-white w-full py-5 text-xl font-medium hover:bg-[#005bb8]\" data-kid=\"104\">\n          Send Message\n        </button>\n      </div>\n    </form>\n    <p class=\"mt-16 text-[var(--text-secondary)] text-sm\" data-kid=\"105\">\n      Typically responds within 24 business hours.\n    </p>\n  </div>\n</section>\n\n\n<footer class=\"bg-[var(--near-white)] border-t border-gray-200 py-12 px-6 lg:px-12\" data-kid=\"106\">\n  <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"107\">\n    <div class=\"flex items-center text-[var(--text-secondary)]\" data-kid=\"108\">\n      <i class=\"ti ti-command\" data-kid=\"109\"></i>\n      <span class=\"ml-2 font-medium\" data-kid=\"110\">Algoritmo Tiendas</span>\n    </div>\n    <div class=\"flex gap-8 text-sm text-[var(--text-secondary)]\" data-kid=\"111\">\n      <a href=\"#\" class=\"hover:text-[var(--text-primary)] transition-colors\" data-kid=\"112\">Privacy Policy</a>\n      <a href=\"#\" class=\"hover:text-[var(--text-primary)] transition-colors\" data-kid=\"113\">Terms of Service</a>\n      <a href=\"#\" class=\"hover:text-[var(--text-primary)] transition-colors\" data-kid=\"114\">Instagram</a>\n    </div>\n    <p class=\"text-sm text-[var(--text-secondary)]\" data-kid=\"115\">\n      © 2026 Algoritmo Tiendas. All rights reserved.\n    </p>\n  </div>\n</footer>",
