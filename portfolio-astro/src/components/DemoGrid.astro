---
import { demos } from "../data/demos";
const base = import.meta.env.BASE_URL;
---
<section class="section" id="trabajos">
  <div class="section-head split reveal">
    <div>
      <p class="label">Trabajos</p>
      <h2>Cuatro direcciones visuales. Ninguna plantilla unica.</h2>
    </div>
    <p>Cada ejemplo muestra una direccion distinta: estetica, ritmo, tono y forma de convertir una visita en contacto.</p>
  </div>
  <div class="demo-grid">
    {demos.map((demo) => (
      <article class="demo-card reveal">
        <a class="demo-cover" href={`${base}${demo.href}`} aria-label={`Abrir demo de ${demo.title}`}>
          <img src={`${base}${demo.image}`} alt="" loading="lazy" decoding="async" />
          <span>{demo.visual}</span>
        </a>
        <div>
          <p class="eyebrow">{demo.sector}</p>
          <h3>{demo.title}</h3>
          <p>{demo.summary}</p>
          <div class="tags">{demo.tags.map((tag) => <span>{tag}</span>)}</div>
          <a class="text-link" href={demo.href}>Abrir demo</a>
        </div>
      </article>
    ))}
  </div>
</section>
